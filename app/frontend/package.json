{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "preview": "vite preview",
    "docker:up": "docker compose -f build/docker/docker-compose.yml up -d --build",
    "docker:up:prod": "docker compose -f build/docker/docker-compose.production.yml up -d --build",
    "docker:down": "docker compose -f build/docker/docker-compose.yml down",
    "docker:down:prod": "docker compose -f build/docker/docker-compose.production.yml down",
    "docker:logs": "docker compose -f build/docker/docker-compose.yml logs -f",
    "docker:logs:prod": "docker compose -f build/docker/docker-compose.production.yml logs -f"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^5.0.0",
    "@vitest/ui": "^5.0.0",
    "jsdom": "^29.1.1",
    "oxlint": "^1.79.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
