{
  "name": "@bookipi-flash-sale/backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "nest build && tsc-alias",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "test": "jest --passWithNoTests --testPathIgnorePatterns=integration.test.ts",
    "test:coverage": "jest --passWithNoTests --testPathIgnorePatterns=integration.test.ts --coverage",
    "test:integration": "jest --passWithNoTests --testRegex=integration.test.ts$ --runInBand",
    "test:stress": "ts-node -r tsconfig-paths/register src/flash-sale/stress-test/run-stress-test.ts",
    "lint": "eslint \"src/**/*.ts\"",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "docker:up": "docker compose -f build/docker/docker-compose.yml -f build/docker/docker-compose.override.yml up -d",
    "docker:up:prod": "docker compose -f build/docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f build/docker/docker-compose.yml -f build/docker/docker-compose.override.yml down",
    "docker:logs": "docker compose -f build/docker/docker-compose.yml -f build/docker/docker-compose.override.yml logs -f"
  },
  "dependencies": {
    "@fastify/static": "^7.0.4",
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-fastify": "^10.4.15",
    "@nestjs/swagger": "^8.1.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "drizzle-orm": "^0.45.2",
    "ioredis": "^6.0.0",
    "postgres": "^3.4.9",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.15",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.9.4",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.2"
  },
  "jest": {
    "rootDir": "src",
    "testRegex": ".test.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "moduleFileExtensions": [
      "ts",
      "js",
      "json"
    ],
    "moduleNameMapper": {
      "^src/(.*)$": "<rootDir>/$1"
    },
    "testTimeout": 15000,
    "collectCoverageFrom": [
      "flash-sale/domain/**/*.ts",
      "!flash-sale/domain/**/*.test.ts",
      "!flash-sale/domain/**/*.interface.ts"
    ]
  }
}
